# === Required secrets (do not commit real production values) ===
DB_PASSWORD=change-me-db-password
JWT_SECRET=change-me-jwt-secret-min-32-chars

# Database
DB_HOST=mysql
DB_PORT=3306
DB_URL=jdbc:mysql://mysql:3306/goodreads
DB_USER=root
WEB_DB_NAME=goodreads_web
MYSQL_PORT=3307

# Public ports on host
BACKEND_PORT=8000
FRONTEND_PORT=3000
DOCKER_FRONTEND_PORT=3001
NGINX_PORT=8090
REDIS_PORT=6379

# Redis / auth / CORS
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8090,http://localhost:8090
WEB_CONCURRENCY=2

# Optional external ML rerank hooks
# ML_RECOMMENDER_URL=
# ML_SENTIMENT_URL=
# ML_QUERY_URL=
# ML_API_KEY=
# RECOMMENDER_API_URL=
