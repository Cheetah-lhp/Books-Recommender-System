# === Required secrets (do not commit real production values) ===
DB_PASSWORD=change-me-db-password
JWT_SECRET=change-me-jwt-secret-min-32-chars

# MySQL cloud (Aiven). Lay gia tri tu muc "Connection information" cua service.
DB_HOST=<service-name>.aivencloud.com
DB_PORT=21595
DB_USER=avnadmin
DB_NAME=defaultdb
WEB_DB_NAME=defaultdb
# Aiven yeu cau SSL. REQUIRED = ma hoa, khong kiem tra cert.
# Neu tai duoc CA certificate: dat file vao ./certs/ca.pem, doi DB_SSL_MODE=VERIFY_CA
# va bat DB_SSL_CA_DOCKER=/app/certs/ca.pem (container) + DB_SSL_CA=./certs/ca.pem (chay tren host).
DB_SSL_MODE=REQUIRED
# DB_SSL_CA=./certs/ca.pem
# DB_SSL_CA_DOCKER=/app/certs/ca.pem
# Tat fallback SQLite: khi MySQL cloud loi thi bao loi, khong ghi vao SQLite local.
DB_ALLOW_SQLITE_FALLBACK=false

# ETL (process/process.py) ghi vao database goodreads tren cung server, khong ghi de bang cua web.
DB_URL=jdbc:mysql://<service-name>.aivencloud.com:21595/goodreads

# Public ports on host
BACKEND_PORT=8000
FRONTEND_PORT=3000
DOCKER_FRONTEND_PORT=3001
NGINX_PORT=8090
REDIS_PORT=6379

# Redis / auth / CORS
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8090,http://localhost:8090
WEB_CONCURRENCY=2

# Hybrid model service (ALS + content + popularity)
RECOMMENDER_PORT=8001
ML_RECOMMENDER_URL=http://recommender:8001
ML_RECOMMEND_TIMEOUT_SECONDS=3
# ML_API_KEY=
# Optional stubs (not implemented in-repo)
# ML_SENTIMENT_URL=
# ML_QUERY_URL=
