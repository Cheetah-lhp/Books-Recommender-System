# Set these in the shell that starts the existing web/start.bat or npm run dev.
# The upstream engine calls this URL with its existing { candidates, history, ... } payload.
ML_RECOMMENDER_URL=http://127.0.0.1:8001/recommend
# Optional; set the same value in the model-service process / Docker Compose.
ML_API_KEY=

# For native model-service execution. Compose already uses host.docker.internal.
ML_CATALOG_URL=http://127.0.0.1:8000
